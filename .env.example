# Copy this file to .env (already git-ignored) and fill in real values:
#   cp .env.example .env
# Never commit .env, and never paste real keys into chat, commits, or logs.
# python-dotenv loads .env automatically from code.main / code.evaluation.*.

# Required for code.routing.engine (Claude Sonnet 5 routing decisions).
ANTHROPIC_API_KEY=

# Required for code.media.audio (Gemini 2.5 voice-note transcription).
# Only one of these needs to be set; GEMINI_API_KEY is checked first.
GEMINI_API_KEY=
GOOGLE_API_KEY=
